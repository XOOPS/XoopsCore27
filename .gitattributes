# Auto detect text files and perform LF normalization
* text=auto

# Ensure LF line endings for specific file types
*.php text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.dist text eol=lf
*.css text eol=lf
*.js text eol=lf
*.html text eol=lf
*.tpl text eol=lf
*.sql text eol=lf

# Git hook scripts must stay LF-only — they run under bash on every
# platform, and a CRLF conversion on Windows would break them on
# Linux/macOS. Glob covers any future hook file (pre-push, post-merge, …).
.githooks/* text eol=lf

# Export ignores (not included in dist packages)
# Name the directory itself: "/dir/** export-ignore" drops the files but
# leaves an empty "dir" folder in the archive.
/_archive export-ignore
/tests export-ignore
/upgrade/tests export-ignore
/htdocs/modules/system/themes/*/tests export-ignore
/tests_codex2 export-ignore
/tools export-ignore
/.ai export-ignore
/.github export-ignore
/.githooks export-ignore

# docs/ ships the end-user documents only: a new file there stays out of
# the package until it is listed here.
/docs/* export-ignore
/docs/2fa-operations.md -export-ignore
/docs/changelog.250.txt -export-ignore
/docs/changelog.270.txt -export-ignore
/docs/changelog.txt -export-ignore
/docs/custom-blocks-tutorial.md -export-ignore
/docs/fixing_permissions.txt -export-ignore
/docs/lang_diff.txt -export-ignore
/docs/license.txt -export-ignore
/docs/README.txt -export-ignore
/docs/TRANSLATIONS.md -export-ignore

.gitattributes export-ignore
.gitignore export-ignore
.editorconfig export-ignore
.scrutinizer.yml export-ignore
.coderabbit.yaml export-ignore
.snyk export-ignore
phpstan.neon export-ignore
phpstan-baseline.neon export-ignore
phpstan-constants.stub.php export-ignore
cliff.toml export-ignore
codecov.yml export-ignore
phpstan2.neon export-ignore
phpstan5.neon export-ignore
phpstan9.neon export-ignore
qodana.yaml export-ignore
renovate.json export-ignore
sonar-project.properties export-ignore
phpinsights.txt export-ignore
CLAUDE.md export-ignore
CONTRIBUTING.md export-ignore
SECURITY.md export-ignore
